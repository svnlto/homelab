{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": [
    "ansible@2.21.1",
    "ansible-lint@25.8.2",
    "molecule@26.6.0",
    "pre-commit@4.5.1",
    "tflint@0.63.1",
    "jq@1.8.2",
    "just@1.57.0",
    "terragrunt@1.0.4",
    "opentofu@1.12.5",
    "kubernetes-helm@4.2.3",
    "kubectl@1.36.2",
    "talosctl@1.13.5",
    "k9s@0.51.0",
    "helm-docs@1.14.2",
    "kubeconform@0.7.0",
    "nodejs@25.9.0",
    "terraform@1.14.9",
    "renovate@43.214.1",
    "uv@0.11.28"
  ],
  "env": {
    "K9S_CONFIG_DIR": "$HOME/.config/k9s",
    "TG_TF_PATH": "terraform"
  },
  "shell": {
    "init_hook": [
      "KUBE_SHARED=\"$PWD/infrastructure/prod/compute/k8s-shared/configs/kubeconfig-shared\"",
      "[ -f \"$KUBE_SHARED\" ] && export KUBECONFIG=\"$KUBE_SHARED\"",
      "TALOS_SHARED=\"$PWD/infrastructure/prod/compute/k8s-shared/configs/talosconfig-shared\"",
      "[ -f \"$TALOS_SHARED\" ] && export TALOSCONFIG=\"$TALOS_SHARED\""
    ]
  }
}
