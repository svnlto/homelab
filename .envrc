#!/bin/bash

# Automatically sets up your devbox environment whenever you cd into this
# directory via our direnv integration:

eval "$(devbox generate direnv --print-envrc)"

# check out https://www.jetify.com/docs/devbox/ide_configuration/direnv/
# for more details

# Load credentials from 1Password into the shell. Skipped when 1Password is
# locked, so a locked vault degrades to "no creds" rather than a broken shell.
if [ -z "${AWS_ACCESS_KEY_ID:-}" ] && [ -f .op-env.tpl ] && has op; then
  if _op_env="$(op inject -i .op-env.tpl 2>/dev/null)"; then
    set -a
    eval "$_op_env"
    set +a
    # Backblaze B2 is the S3-compatible backend for terragrunt state
    export AWS_ACCESS_KEY_ID="$B2_KEY_ID"
    export AWS_SECRET_ACCESS_KEY="$B2_APPLICATION_KEY"
    # provider.hcl composes api_token as "${id}=${secret}"
    export TF_VAR_proxmox_api_token_id="$PROXMOX_TOKEN_ID"
    export TF_VAR_proxmox_api_token_secret="$PROXMOX_TOKEN_SECRET"
  else
    log_status "1Password locked — terragrunt credentials not loaded"
  fi
  unset _op_env
fi
