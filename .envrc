#!/bin/bash

# Automatically sets up your devbox environment whenever you cd into this
# directory via our direnv integration:

eval "$(devbox generate direnv --print-envrc)"

# check out https://www.jetify.com/docs/devbox/ide_configuration/direnv/
# for more details

# No credentials are resolved here. Entering the directory used to cost ~20
# 1Password API reads, which exhausted the account's daily quota once agent
# shells started spawning. Credentials are now fetched at point of use:
# terragrunt reads them via run_cmd("op", "read", ...) in the *.hcl inputs,
# and the justfile wraps terragrunt/ansible in `op run --env-file`.

# Point SSH at the 1Password agent. Without this, SSH_AUTH_SOCK stays on the
# macOS launchd default, which holds no keys — so Proxmox provider applies
# fail with a misleading ssh-agent error rather than "no key". Costs no API
# reads: this is a local socket path, not a vault lookup.
_op_ssh_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
if [ -S "$_op_ssh_sock" ]; then
  export SSH_AUTH_SOCK="$_op_ssh_sock"
else
  log_status "1Password SSH agent socket not found — SSH_AUTH_SOCK left unchanged"
fi
unset _op_ssh_sock
